#!/bin/sh
# Формат сообщения коммита — docs/conventions/git.md.

set -eu

message_file=$1
subject=$(sed -n '1p' "$message_file")

fail() {
    printf '\n[commit-msg] %s\n\n' "$1" >&2
    exit 1
}

# Комментарии и пустые сообщения git отсекает сам; merge/revert не трогаем.
case "$subject" in
    ''|'#'*|Merge\ *|Revert\ *) exit 0 ;;
esac

# --- Длина заголовка ----------------------------------------------------------
length=$(printf '%s' "$subject" | wc -m | tr -d ' ')

if [ "$length" -gt 72 ]; then
    fail "Заголовок $length символов, максимум 72. Подробности — в теле коммита."
fi

# --- Язык: коммиты английские (AGENTS.md) -------------------------------------
if printf '%s' "$subject" | grep -q '[А-Яа-яЁё]'; then
    fail "Заголовок на русском. Код, идентификаторы и коммиты — английские;
русский остаётся для docs/ и текстов интерфейса (AGENTS.md)."
fi

# --- Точка в конце заголовка --------------------------------------------------
case "$subject" in
    *.) fail "Заголовок не заканчивается точкой." ;;
esac

exit 0
