{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_wide_fs_search.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(find / *)",
      "Bash(find -L / *)",
      "Bash(find -H / *)",
      "Bash(find /c/ *)",
      "Bash(find -L /c/ *)",
      "Bash(find /c *)",
      "Bash(find /c/Users *)",
      "Bash(find ~ *)",
      "Bash(sudo find / *)",
      "PowerShell(Get-ChildItem -Path C:\\ -Recurse*)",
      "PowerShell(Get-ChildItem C:\\ -Recurse*)",
      "PowerShell(gci C:\\ -Recurse*)",
      "PowerShell(ls C:\\ -Recurse*)"
    ]
  }
}
